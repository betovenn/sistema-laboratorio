# Copia este archivo a .env y cambia TODAS las contraseñas.
# .env está en .gitignore y nunca debe subirse al repositorio.

# --- PostgreSQL: superusuario del contenedor ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiame_superusuario

# --- Una contraseña por servicio: cada uno solo puede abrir su propia base ---
IAM_DB_PASSWORD=cambiame_iam
ESCOLAR_DB_PASSWORD=cambiame_escolar
LOGISTICA_DB_PASSWORD=cambiame_logistica
EQUIPOS_DB_PASSWORD=cambiame_equipos
EJECUCION_DB_PASSWORD=cambiame_ejecucion
EVALUACION_DB_PASSWORD=cambiame_evaluacion

# --- MongoDB (academico-service) ---
MONGO_USER=academico
MONGO_PASSWORD=cambiame_mongo

# --- RabbitMQ ---
RABBITMQ_USER=laboratorio
RABBITMQ_PASSWORD=cambiame_rabbit

# --- Firma de tokens (iam-service) ---
# La llave privada NO va aquí: se monta como archivo. Genérala una vez con:
#   mkdir -p infra/llaves
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out infra/llaves/privada.pem
#   chmod 644 infra/llaves/privada.pem
# El chmod es porque el contenedor corre con otro usuario. *.pem está en .gitignore.
# La clave pública no hace falta: iam-service la publica en /v1/.well-known/jwks.json.
JWT_ISSUER=iam-service
JWT_ACCESO_MINUTOS=60
JWT_REFRESCO_HORAS=8

# --- Solo desarrollo ---
# Crea el usuario 11111 / 12345 (ALUMNO) mientras no exista /v1/registro.
IAM_USUARIO_PRUEBA=true
